# Rackloom support service. Copy to .env (chmod 600) on the server; never commit the real file.
# Placeholders only. Generate secrets on the server: openssl rand -hex 24 (passwords), -hex 32 (tokens).

# --- Database: this project's own Postgres (support-db), never published on the host ---------------
# Owner: used only by `docker compose --profile tools run --rm migrate`.
SUPPORT_DB_OWNER_PASSWORD=
# support_app, the runtime role. The migrate tool sets this password on the role.
SUPPORT_DB_APP_PASSWORD=

# --- The public site --------------------------------------------------------------------------------
# Links in Discord and email, the expected Turnstile hostname, and Secure cookies (https).
SUPPORT_PUBLIC_URL=https://rackloom.in
# Browser origins allowed to call the API and open chat sockets. Empty = SUPPORT_PUBLIC_URL and its www twin.
SUPPORT_ALLOWED_ORIGINS=

# --- Shared with the web app -------------------------------------------------------------------------
# The /admin/support page calls /internal/* with this. Put the SAME value in /opt/rackloom/web/.env.
SUPPORT_INTERNAL_TOKEN=

# --- Cloudflare Turnstile: the same widget as the account forms (docs/TURNSTILE-PLAN.md) --------------
# TURNSTILE_SITE_KEY: the value already in /opt/rackloom/web/.env. TURNSTILE_SECRET: the value already in
# /opt/rackloom/auth/.env. Required in production; the service refuses to start without the secret.
# Local work: site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# 1 only on a scratch stack served over https with the test keys. Never on rackloom.in.
TURNSTILE_ALLOW_TEST_KEYS=

# --- Discord --------------------------------------------------------------------------------------------
# Private support channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
# Secret: anyone with it can post to the channel. Empty = tickets queue and are sent once it is set.
SUPPORT_DISCORD_WEBHOOK_URL=

# --- Mail: the return link and the new-browser code (same relay as web and auth) ------------------------
# Production today: SMTP_HOST=smtp-relay.gmail.com, SMTP_PORT=587, no user or password (IP-allowlisted).
# Empty in production = no mail: copied links then open only in the browser that created the ticket.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Rackloom <support@rackloom.in>"
# Named in emails and in the "can't verify you here" message.
SUPPORT_CONTACT_EMAIL=support@rackloom.in

# --- Compose -------------------------------------------------------------------------------------------
# The main stack's Docker network (its compose project is "web", so "web_default").
RACKLOOM_NETWORK=web_default
LOG_LEVEL=info
